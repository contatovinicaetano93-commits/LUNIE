# Chave de segurança do Hiper: Vendas > Loja virtual > Configurações.
# Não use a senha da conta. A chave tem 64 caracteres e vira um token em
# https://ms-ecommerce.hiper.com.br/api/v1/auth/gerar-token/{chave}.
HIPER_API_KEY=
HIPER_API_BASE_URL=https://ms-ecommerce.hiper.com.br

# Access token e store id gerados ao instalar o app na Nuvemshop.
# O ID e o segredo do aplicativo não substituem esses dois campos.
# Escopos: read_products e read_orders.
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_STORE_ID=
NUVEMSHOP_API_VERSION=2025-03
NUVEMSHOP_USER_AGENT=LUNIE (estoque@lunie.local)
